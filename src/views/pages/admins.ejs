
<div class="page-intro">
  <div>
    <h2>Admin accounts</h2>
    <p>Manage administrator accounts and their access levels.</p>
  </div>

  <a href="/admin/admins/new" class="button-primary">
    + Create Admin
  </a>
</div>

<div class="table-card">
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Email</th>
          <th>Role</th>
          <th>Created</th>
          <th>Updated</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if (admins.length === 0) { %>
          <tr>
            <td colspan="5" class="empty-state">
              No admin accounts found.
            </td>
          </tr>
        <% } %>

        <% admins.forEach((admin) => { %>
          <tr>
            <td><strong><%= admin.email %></strong></td>

            <td>
              <span class="admin-role-badge <%= admin.role === 'superadmin' ? 'role-superadmin' : 'role-admin' %>">
                <%= admin.role %>
              </span>
            </td>

            <td>
              <%= admin.createdAt ? new Date(admin.createdAt).toLocaleDateString() : "—" %>
            </td>

            <td>
              <%= admin.updatedAt ? new Date(admin.updatedAt).toLocaleDateString() : "—" %>
            </td>

            <td>
              <a
                class="view-link"
                href="/admin/admins/<%= admin._id %>/edit"
              >
                Edit role
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="pagination-bar">
    <span>
      <%= pagination.totalAdmins %> admin account(s)
    </span>

    <div class="pagination-actions">
      <% if (pagination.page > 1) { %>
        <a
          class="button-secondary"
          href="/admin/admins?page=<%= pagination.page - 1 %>"
        >
          Previous
        </a>
      <% } %>

      <span class="page-number">
        Page <%= pagination.page %> of <%= Math.max(1, pagination.totalPages) %>
      </span>

      <% if (pagination.page < pagination.totalPages) { %>
        <a
          class="button-secondary"
          href="/admin/admins?page=<%= pagination.page + 1 %>"
        >
          Next
        </a>
      <% } %>
    </div>
  </div>
</div>
