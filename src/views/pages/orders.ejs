

<section class="stats-grid">
  <div class="stat-card">
    <span class="stat-label">Total Orders</span>
    <strong class="stat-value"><%= stats.totalOrders %></strong>
  </div>

  <div class="stat-card">
    <span class="stat-label">Pending</span>
    <strong class="stat-value"><%= stats.pending %></strong>
  </div>

  <div class="stat-card">
    <span class="stat-label">Processing</span>
    <strong class="stat-value"><%= stats.processing %></strong>
  </div>

  <div class="stat-card">
    <span class="stat-label">Completed</span>
    <strong class="stat-value"><%= stats.completed %></strong>
  </div>

  <div class="stat-card">
    <span class="stat-label">Failed</span>
    <strong class="stat-value"><%= stats.failed %></strong>
  </div>
</section>


<div class="page-intro">
    
  <div>
    <h2>All orders</h2>
    <p>Monitor and inspect orders stored in MongoDB.</p>
  </div>

  <div class="total-count">
    <strong><%= pagination.totalOrders %></strong>
    <span>Total matching orders</span>
  </div>
</div>

<form class="filter-bar" method="GET" action="/admin/orders">
  <input
    type="search"
    name="search"
    placeholder="Search product ID or email..."
    value="<%= filters.search %>"
  >

  <select name="status">
    <option value="">All statuses</option>
    <% ["pending", "processing", "completed", "failed"].forEach((status) => { %>
      <option
        value="<%= status %>"
        <%= filters.status === status ? "selected" : "" %>
      >
        <%= status.charAt(0).toUpperCase() + status.slice(1) %>
      </option>
    <% }) %>
  </select>

  <input type="hidden" name="limit" value="<%= pagination.limit %>">

  <button type="submit" class="button-primary">Apply filters</button>
  <a href="/admin/orders" class="button-secondary">Reset</a>
</form>

<div class="table-card">
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Customer email</th>
          <th>Quantity</th>
          <th>Status</th>
          <th>Created</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="6" class="empty-state">
              No orders match your filters.
            </td>
          </tr>
        <% } %>

        <% orders.forEach((order) => { %>
          <tr>
            <td class="product-id"><%= order.productId %></td>
            <td><%= order.email %></td>
            <td><%= order.quantity %></td>
            <td>
              <span class="status-badge status-<%= order.status %>">
                <%= order.status %>
              </span>
            </td>
            <td>
              <%= new Date(order.createdAt).toLocaleString() %>
            </td>
            <td>
              <a
                class="view-link"
                href="/admin/orders/<%= order._id %>"
              >
                View
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="pagination-bar">
    <span>
      <% if (pagination.totalOrders > 0) { %>
        Showing
        <%= (pagination.page - 1) * pagination.limit + 1 %>–<%=
          Math.min(
            pagination.page * pagination.limit,
            pagination.totalOrders
          )
        %>
        of <%= pagination.totalOrders %>
      <% } else { %>
        No results
      <% } %>
    </span>

    <div class="pagination-actions">
      <% if (pagination.page > 1) { %>
        <a class="button-secondary"
           href="/admin/orders?<%= new URLSearchParams({
             page: String(pagination.page - 1),
             limit: String(pagination.limit),
             status: filters.status,
             search: filters.search
           }).toString() %>">
          Previous
        </a>
      <% } %>

      <span class="page-number">
        Page <%= pagination.page %> of
        <%= Math.max(1, pagination.totalPages) %>
      </span>

      <% if (pagination.page < pagination.totalPages) { %>
        <a class="button-secondary"
           href="/admin/orders?<%= new URLSearchParams({
             page: String(pagination.page + 1),
             limit: String(pagination.limit),
             status: filters.status,
             search: filters.search
           }).toString() %>">
          Next
        </a>
      <% } %>
    </div>
  </div>
</div>
